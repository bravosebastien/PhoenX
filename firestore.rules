rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══ USERS — Profil Créateur ═══
    match /users/{userId} {
      // Lecture : Propriétaire OU Dépositaire OU Destinataire activé
      // Correctif 20/09/2026 : cette règle ne couvrait pas le cas Destinataire, contrairement
      // à toutes les autres collections — bloquait la lecture du nom du créateur (ex: écran 100 Questions).
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (resource != null && request.auth.uid in resource.data.get('depositaryUids', [])) ||
        (resource != null &&
          resource.data.get('protocolStatus', '') == "activated" &&
          (userId + '_recipient') in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('myRoles', {}))
      );

      // Création : Interdiction d'auto-attribuer des rôles ou de forcer les UIDs dépositaires
      allow create: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.keys().hasAny(['myRoles', 'isCreator', 'depositaryUids']);

      // FUSION SÉCURISÉE v9.4.8 : Un seul bloc update, toutes protections actives
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['myRoles', 'isCreator', 'depositaryUids'])
                    && (!resource.data.get('isIdentityLocked', false)
                        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['firstName', 'lastName', 'isIdentityLocked']));

      // ═══ ENTRIES — Souvenirs ═══
      match /entries/{entryId} {
        allow write: if request.auth != null && request.auth.uid == userId;
        // Lecture héritier : Verrouillage post-mortem (Sécurisation champs v9.4.4)
        allow read: if request.auth != null && (
          request.auth.uid == userId || (
            get(/databases/$(database)/documents/users/$(userId)).data.protocolStatus == "activated" &&
            (userId + '_recipient') in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.myRoles && (
              resource.data.get('visibility', 'RESTRICTED') == "EVERYONE" ||
              request.auth.uid in resource.data.get('recipientIds', [])
            )
          )
        );

        match /amendments/{amendmentId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // ═══ STANDALONE MEDIA — Dépôts directs ═══
      match /standaloneMedia/{mediaId} {
        allow write: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && (
          request.auth.uid == userId || (
            get(/databases/$(database)/documents/users/$(userId)).data.protocolStatus == "activated" &&
            (userId + '_recipient') in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.myRoles && (
              resource.data.get('visibility', 'RESTRICTED') == "EVERYONE" ||
              request.auth.uid in resource.data.get('recipientIds', [])
            )
          )
        );
      }

      // ═══ BOOK — Livre de Ma Vie (Règle corrigée v9.4.4 / Sécurisation v9.4.27) ═══
      match /book/{bookId} {
        allow write: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && (
          request.auth.uid == userId || (
            get(/databases/$(database)/documents/users/$(userId)).data.protocolStatus == "activated" &&
            (userId + '_recipient') in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.myRoles && (
              // v9.4.27 : Un champ absent est traité comme RESTRICTED par défaut.
              (resource.data.get('visibility', 'RESTRICTED') == "EVERYONE") ||
              (request.auth.uid in resource.data.get('recipientIds', []))
            )
          )
        );
      }

      // ═══ KEYS — Clés miroirs ═══
      match /book_keys/{keyId} {
        allow write: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && (
          request.auth.uid == userId || (
            get(/databases/$(database)/documents/users/$(userId)).data.protocolStatus == "activated" &&
            (userId + '_recipient') in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.myRoles
          )
        );
      }

      match /entry_keys/{keyId} {
        allow write: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && (
          request.auth.uid == userId || (
            get(/databases/$(database)/documents/users/$(userId)).data.protocolStatus == "activated" &&
            (userId + '_recipient') in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.myRoles
          )
        );
      }

      // ═══ VIDÉO DE PRÉSENTATION DE L'HÉRITAGE — un seul document "main", public à tous les Destinataires ═══
      match /legacyVideo/{docId} {
        allow write: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && (
          request.auth.uid == userId || (
            get(/databases/$(database)/documents/users/$(userId)).data.protocolStatus == "activated" &&
            (userId + '_recipient') in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.myRoles
          )
        );
      }

      // ═══ PERSONS — Répertoire ═══
      match /persons/{personId} {
        allow write: if request.auth != null && request.auth.uid == userId;
        // Correction v9.6.5 : Un destinataire ne peut pas lire une personne "PRIVATE" (Rencontre "Gardé pour moi")
        allow read: if request.auth != null && (request.auth.uid == userId || (
          get(/databases/$(database)/documents/users/$(userId)).data.protocolStatus == "activated" &&
          (userId + '_recipient') in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.myRoles &&
          resource.data.get("visibility", "PUBLIC") != "PRIVATE"
        ));

        // Sous-collection Médias (v12.2)
        match /media/{mediaId} {
           allow write: if request.auth != null && request.auth.uid == userId;
           allow read: if request.auth != null && (request.auth.uid == userId || (
             get(/databases/$(database)/documents/users/$(userId)).data.protocolStatus == "activated" &&
             (userId + '_recipient') in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.myRoles &&
             get(/databases/$(database)/documents/users/$(userId)/persons/$(personId)).data.get("visibility", "PUBLIC") != "PRIVATE"
           ));
        }
      }

      // ═══ PERSONALITIES — Tiroir dédié v9.7.0 ═══
      match /personalities/{personalityId} {
        allow write: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && (request.auth.uid == userId || (
          get(/databases/$(database)/documents/users/$(userId)).data.protocolStatus == "activated" &&
          (userId + '_recipient') in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.myRoles
        ));

        // Sous-collection Médias
        match /media/{mediaId} {
           allow write: if request.auth != null && request.auth.uid == userId;
           allow read: if request.auth != null && (request.auth.uid == userId || (
             get(/databases/$(database)/documents/users/$(userId)).data.protocolStatus == "activated" &&
             (userId + '_recipient') in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.myRoles
           ));
        }
      }

      // ═══ PENDING QUESTIONS ═══
      match /pendingQuestions/{questionId} {
        allow update: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && (
          request.auth.uid == userId || (
            get(/databases/$(database)/documents/users/$(userId)).data.protocolStatus == "activated" &&
            (userId + '_recipient') in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.myRoles &&
            request.auth.uid == resource.data.recipientId
          )
        );
        allow create, delete: if false;
      }

      // ═══ LEGACIES — Clés uniques ═══
      match /legacies/{legacyId} {
        allow write: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && (
           request.auth.uid == userId || (
             get(/databases/$(database)/documents/users/$(userId)).data.protocolStatus == "activated" &&
             request.auth.uid == resource.data.recipientId
           )
        );
      }

      // ═══ WITNESSES — Témoins ═══
      match /witnesses/{witnessId} {
        allow read: if request.auth != null && (
          request.auth.uid == userId || (
            get(/databases/$(database)/documents/users/$(userId)).data.protocolStatus == "activated" &&
            (userId + '_recipient') in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.myRoles &&
            resource.data.status == "validated"
          )
        );
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // ═══ QUIZZES ═══
      match /quizzes/{quizId} {
        allow write: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && (
          request.auth.uid == userId || (
            get(/databases/$(database)/documents/users/$(userId)).data.protocolStatus == "activated" &&
            (userId + '_recipient') in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.myRoles && (
              resource.data.get('visibility', 'RESTRICTED') == "EVERYONE" ||
              request.auth.uid in resource.data.get('recipientIds', [])
            )
          )
        );
      }

      match /quizResults/{resultId} {
        allow read: if request.auth != null && (request.auth.uid == userId || request.auth.uid == resource.data.recipientId);
        allow create: if request.auth != null && request.resource.data.recipientId == request.auth.uid;
        allow update, delete: if false;
      }

      match /guessResults/{resultId} {
        allow read: if request.auth != null && (request.auth.uid == userId || request.auth.uid == resource.data.recipientId);
        allow create: if false; // Écrit via Cloud Function submitGuessResult
        allow update, delete: if false;
      }

      // ═══ RANKINGS — Mes Classements v12.2 ═══
      match /rankings/{rankingId} {
        allow write: if request.auth != null && request.auth.uid == userId;
        // Lecture ouverte au propriétaire OU à tout Destinataire activé (v12.2)
        allow read: if request.auth != null && (request.auth.uid == userId || (
          get(/databases/$(database)/documents/users/$(userId)).data.protocolStatus == "activated" &&
          (userId + '_recipient') in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.myRoles
        ));

        // Sous-collection Médias par rang (v12.8)
        match /rankMedia/{mediaId} {
          allow write: if request.auth != null && request.auth.uid == userId;
          allow read: if request.auth != null && (request.auth.uid == userId || (
            get(/databases/$(database)/documents/users/$(userId)).data.protocolStatus == "activated" &&
            (userId + '_recipient') in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.myRoles
          ));
        }
      }

      // ═══ LIBRARY COVERS — Couvertures de compartiments (v12.2) ═══
      match /libraryCover/{compartmentId} {
        allow write: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && (request.auth.uid == userId || (
          get(/databases/$(database)/documents/users/$(userId)).data.protocolStatus == "activated" &&
          (userId + '_recipient') in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.myRoles
        ));
      }

      // ═══ PACTS ═══
      match /pacts/{pactId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ═══ LOCATIONS — Géographie v9.4.27 ═══
      match /locations/{locationId} {
        allow write: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && (
          request.auth.uid == userId || (
            get(/databases/$(database)/documents/users/$(userId)).data.protocolStatus == "activated" &&
            (userId + '_recipient') in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.myRoles
          )
        );
      }
      match /recipients/{recipientId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /depositaries/{depositaryId} {
        allow write: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && (request.auth.uid == userId || resource.data.depositaryUid == request.auth.uid);
      }
      match /notificationContacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /silenceNotifications/{notifId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update, delete: if false;
      }
      match /reconciliations/{reconciliationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ═══ MIRRORS — Miroir à Deux v9.4.27 ═══
    match /mirrors/{mirrorId} {
      // Lecture/Écriture si l'utilisateur est l'un des deux créateurs
      allow read, write: if request.auth != null && (
        request.auth.uid == resource.data.creatorAId ||
        request.auth.uid == resource.data.creatorBId
      );
      // Création autorisée pour tout utilisateur authentifié (le document doit contenir son UID)
      allow create: if request.auth != null && request.resource.data.creatorAId == request.auth.uid;
    }

    // ═══ LIVING LINKS — Transmission Active v9.4.27 ═══
    match /livingLinks/{linkId} {
      // Lecture : Destinataire (si envoyé) OU Créateur
      allow read: if request.auth != null && (
        (request.auth.uid == resource.data.recipientId && resource.data.status == "sent") ||
        request.auth.uid == resource.data.creatorId
      );
      // Écriture : Uniquement le Créateur
      allow write: if request.auth != null && (
        (resource == null && request.resource.data.creatorId == request.auth.uid) ||
        (resource != null && resource.data.creatorId == request.auth.uid)
      );
    }

    // ═══ PUBLIC KEYS — Clés RSA Publiques v12.7.9 ═══
    match /publicKeys/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /activationProtocols/{protocolId} {
      allow read: if request.auth != null && (
        resource.data.creatorId == request.auth.uid ||
        resource.data.depositaryUid == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    match /invitations/{tokenId} {
      allow read: if request.auth != null && request.auth.token.email.lower() == resource.data.email.lower();
      allow write: if false;
    }

    match /mail/{mailId} {
      allow read, write: if false;
    }

    match /presentationVideos/{videoId} {
      allow read: if true;
      allow write: if false;
    }

    // Configuration globale de l'app (Arbre, etc.) v9.4.22
    match /appConfig/{configId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
