{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PhoenXRevenueExport",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "transaction_id",
      "purchase_type",
      "purchase_date",
      "currency",
      "gross_amount",
      "google_commission_rate",
      "google_commission_amount",
      "net_amount",
      "store"
    ],
    "properties": {
      "transaction_id": { "type": "string" },
      "app_user_id": { "type": "string" },
      "product_id": { "type": "string" },
      "purchase_type": {
        "type": "string",
        "enum": ["NON_CONSUMABLE", "SUBSCRIPTION", "RENEWAL", "REFUND"]
      },
      "purchase_date": { "type": "string", "format": "date-time" },
      "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
      "gross_amount": { "type": "number", "minimum": 0 },
      "estimated_vat_amount": { "type": "number", "minimum": 0 },
      "google_commission_rate": { "type": "number", "minimum": 0, "maximum": 1 },
      "google_commission_amount": { "type": "number", "minimum": 0 },
      "net_amount": { "type": "number" },
      "country_code": { "type": "string" },
      "store": {
        "type": "string",
        "enum": ["play_store", "app_store", "stripe"]
      }
    }
  }
}
